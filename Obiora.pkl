import streamlit as st
import pandas as pd
import joblib

# ---------------------------------
# Title
# ---------------------------------
st.title('HEART DISEASE RISK PREDICTION')
st.header('Demo Day Project')
st.write('NOTE: To be filled by your physician')
st.markdown("---")

# ---------------------------------
# Patient Inputs
# ---------------------------------
st.subheader("Patient Information")

name = st.text_input("Patient Name")

col1, col2, col3 = st.columns(3)

with col1:
    age = st.number_input("Age", min_value=10, max_value=100, value=45)
    sex = st.radio("Sex", ["Male", "Female"])
    resting_bp_systolic = st.number_input("Resting BP Systolic", value=120)
    resting_bp_diastolic = st.number_input("Resting BP Diastolic", value=80)
    cholesterol_total = st.number_input("Total Cholesterol", value=200)
    hdl = st.number_input("HDL", value=50)
    ldl = st.number_input("LDL", value=120)
    triglycerides = st.number_input("Triglycerides", value=150)

with col2:
    fasting_blood_sugar = st.number_input("Fasting Blood Sugar", value=100)
    hba1c = st.number_input("HbA1c (%)", value=5.5, step=0.1)
    bmi = st.number_input("BMI", value=25.0, step=0.1)
    resting_heart_rate = st.number_input("Resting Heart Rate", value=72)
    max_heart_rate_achieved = st.number_input("Max Heart Rate Achieved", value=150)
    st_depression = st.number_input("ST Depression", value=0.0, step=0.1)
    alcohol_units_per_week = st.number_input("Alcohol Units per Week", value=2)
    exercise_minutes_per_week = st.number_input("Exercise Minutes per Week", value=150)

with col3:
    chest_pain_type = st.selectbox("Chest Pain Type", 
                                   ["Typical Angina", "Atypical Angina", "Non-anginal Pain", "Asymptomatic"])
    exercise_induced_angina = st.selectbox("Exercise Induced Angina", ["No", "Yes"])
    family_history = st.selectbox("Family History of Heart Disease", ["No", "Yes"])
    smoker_status = st.selectbox("Smoker Status", ["Never", "Former", "Current"])
    sleep_hours = st.number_input("Sleep Hours per Night", value=7.0, step=0.5)
    stress_score = st.slider("Stress Score (1-10)", 1, 10, 5)
    wearable_owner = st.selectbox("Owns Wearable Device?", ["No", "Yes"])
    daily_steps = st.number_input("Daily Steps", value=7000)
    diet_quality_score = st.slider("Diet Quality Score (1-10)", 1, 10, 6)

# ---------------------------------
# Predict Button
# ---------------------------------
if st.button("🔍 Predict Heart Disease Risk", use_container_width=True):

    # Convert text to numbers (same as training)
    sex_num = 0 if sex == "Male" else 1
    family_history_num = 1 if family_history == "Yes" else 0
    wearable_owner_num = 1 if wearable_owner == "Yes" else 0
    smoker_num = {"Never": 0, "Former": 1, "Current": 2}[smoker_status]
    angina_num = 1 if exercise_induced_angina == "Yes" else 0

    # Create DataFrame with all features
    data = pd.DataFrame([{
        "age": age,
        "sex": sex_num,
        "resting_bp_systolic": resting_bp_systolic,
        "resting_bp_diastolic": resting_bp_diastolic,
        "cholesterol_total": cholesterol_total,
        "hdl": hdl,
        "ldl": ldl,
        "triglycerides": triglycerides,
        "fasting_blood_sugar": fasting_blood_sugar,
        "hba1c": hba1c,
        "bmi": bmi,
        "resting_heart_rate": resting_heart_rate,
        "max_heart_rate_achieved": max_heart_rate_achieved,
        "chest_pain_type": chest_pain_type,
        "exercise_induced_angina": angina_num,
        "st_depression": st_depression,
        "family_history": family_history_num,
        "smoker_status": smoker_num,
        "alcohol_units_per_week": alcohol_units_per_week,
        "exercise_minutes_per_week": exercise_minutes_per_week,
        "sleep_hours": sleep_hours,
        "stress_score": stress_score,
        "wearable_owner": wearable_owner_num,
        "daily_steps": daily_steps,
        "diet_quality_score": diet_quality_score
    }])

    # Load model and predict
    try:
        model = joblib.load("Obiora.pkl")
        prediction = model.predict(data)[0]
        probability = model.predict_proba(data)[0][1] * 100

        st.markdown("---")
        st.subheader(f"Result for {name if name else 'Patient'}")

        if prediction == 1:
            st.error(f"⚠️ **High Risk** of Heart Disease")
            st.write(f"Probability: **{probability:.1f}%**")
        else:
            st.success(f"✅ **Low Risk** of Heart Disease")
            st.write(f"Probability: **{probability:.1f}%**")

        st.progress(probability / 100)

    except FileNotFoundError:
        st.error("❌ Model file **Obiora.pkl** not found. Please upload it to your GitHub repository.")
